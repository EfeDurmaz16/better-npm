{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Better Lock",
  "scopeName": "source.better-lock",
  "patterns": [
    { "include": "#keys" },
    { "include": "#versions" },
    { "include": "#integrity" },
    { "include": "#urls" },
    { "include": "#booleans" },
    { "include": "#numbers" }
  ],
  "repository": {
    "keys": {
      "match": "\"(name|version|resolved|integrity|dependencies|engines|ecosystem|packages|lockfileVersion|requires|dev|optional|peer|bundled|bin|scripts|license|funding)\"\\s*:",
      "captures": {
        "1": { "name": "keyword.other.better-lock" }
      }
    },
    "versions": {
      "match": "\"(\\d+\\.\\d+\\.\\d+[^\"]*?)\"",
      "captures": {
        "1": { "name": "constant.numeric.version.better-lock" }
      }
    },
    "integrity": {
      "match": "\"(sha(256|384|512)-[A-Za-z0-9+/=]+)\"",
      "captures": {
        "1": { "name": "string.quoted.integrity.better-lock" }
      }
    },
    "urls": {
      "match": "\"(https?://[^\"]+)\"",
      "captures": {
        "1": { "name": "string.quoted.url.better-lock" }
      }
    },
    "booleans": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.better-lock"
    },
    "numbers": {
      "match": "\\b([0-9]+)\\b",
      "name": "constant.numeric.integer.better-lock"
    }
  }
}
